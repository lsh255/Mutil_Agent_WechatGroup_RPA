# ========================================
# 多模态Agent微信群自动化项目 - 环境变量配置示例
# ========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. .env 文件会被 .gitignore 忽略，不会提交到版本控制

# 项目基础配置
PROJECT__NAME=wechat-workflow-agent
PROJECT__ENV=development

# LangGraph工作流配置
LANGGRAPH__STATE_STORE=redis://localhost:6379/0
LANGGRAPH__CHECKPOINT_ENABLED=true

# AI模型服务配置
AI__OLLAMA__BASE_URL=http://localhost:11434
AI__OLLAMA__VISION_MODEL=qwen3-vl-8b:latest
AI__SILICONFLOW__API_KEY=your_api_key_SILICONFLOW

# 向量数据库配置
VECTOR_STORE__TYPE=chroma
VECTOR_STORE__PERSIST_DIRECTORY=./data/chroma_db
VECTOR_STORE__COLLECTION_NAME=work_knowledge_base

# 微信沙盒配置
WECHAT_SANDBOX__DOCKER_IMAGE=wechat-sandbox:latest
WECHAT_SANDBOX__PRODUCER_SERVICE_URL=http://localhost:6789
WECHAT_SANDBOX__DATA_VOLUME=./data/wechat_profile

# 工具配置
TOOLS__EXCEL_TEMPLATE_PATH=./templates/task_log.xlsx
TOOLS__REPORT_TEMPLATE_PATH=./templates/daily_report.j2
TOOLS__OUTPUT_DIR=./output

# Redis配置
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__LOCK_DB=1

# 日志配置
LOGGING__LEVEL=INFO
LOGGING__FORMAT=json

# Python环境配置
PYTHONPATH=./
PYTHONUNBUFFERED=1

# FastAPI配置
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Docker配置
COMPOSE_PROJECT_NAME=wechat-workflow-agent
