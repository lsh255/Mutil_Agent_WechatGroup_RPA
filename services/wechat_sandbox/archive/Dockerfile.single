# =====================================================
# 分层 Dockerfile - WeChat 沙箱单实例部署
# =====================================================
# 分层策略：
#   1. 基础系统层（几乎不变）
#   2. 桌面环境层（低频变动）
#   3. WeChat 基础依赖层（偶尔变动）
#   4. 字体层（低频变动）
#   5. WeChat 应用层（偶尔变动）
#   6. 依赖补丁层（高频变动，方便添加缺失依赖）
#   7. Python 环境层（可选，如需 Python 功能）
#   8. 配置层（经常变动）
# =====================================================

FROM ubuntu:22.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV PYTHONUNBUFFERED=1

# =====================================================
# 层 1：基础系统工具（几乎不变）
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 2：桌面环境（VNC + noVNC + X11 + Fluxbox）
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    xvfb \
    x11-apps \
    fluxbox \
    tigervnc-standalone-server \
    tigervnc-common \
    tigervnc-tools \
    novnc \
    websockify \
    x11vnc \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 3：WeChat 基础依赖（GUI 库 + 多媒体库）
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libnotify4 \
    libnss3 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    libatspi2.0-0 \
    libappindicator3-1 \
    libsecret-1-0 \
    libgbm1 \
    libdbus-1-3 \
    libasound2 \
    libpulse0 \
    libpci3 \
    libpci-dev \
    libatomic1 \
    desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 4：字体支持
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    fonts-wqy-microhei \
    fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 5：复制并安装本地字体包
# =====================================================
COPY fonts-noto-cjk_20240730+repack1-1_all.deb /tmp/
RUN dpkg -i /tmp/fonts-noto-cjk_20240730+repack1-1_all.deb

# =====================================================
# 层 6：WeChat 应用安装
# =====================================================
COPY WeChatLinux_x86_64.deb /tmp/
RUN dpkg --force-depends -i /tmp/WeChatLinux_x86_64.deb && \
    apt-get install -y -f

# =====================================================
# 层 7：依赖补丁层（后续发现缺失依赖可在此添加）
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 8：Python 环境（可选，如需 Python 功能）
# =====================================================
RUN apt-get update && apt-get install -y --fix-missing \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# =====================================================
# 层 9：配置与启动脚本
# =====================================================
RUN mkdir -p /root/.vnc && \
    chmod 700 /root/.vnc

RUN mkdir -p /app/media /app/logs

COPY start_wechat.sh /app/
RUN chmod +x /app/start_wechat.sh

EXPOSE 6080 5900

CMD ["/app/start_wechat.sh"]
